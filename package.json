{
  "name": "mthunzi-creations",
  "version": "0.1.0",
  "description": "Mthunzi Creations website with Docker-ready Node backend.",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "dev:frontend": "vite --config vite.config.mjs",
    "build:frontend": "vite build --config vite.config.mjs && node scripts/publish-frontend.cjs",
    "check:frontend": "tsc --noEmit -p storefront/tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "pg": "^8.11.2",
    "qs": "^6.17.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
