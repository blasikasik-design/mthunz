{
  "name": "mthunzi-creations",
  "version": "0.1.0",
  "description": "Mthunzi Creations website with Docker-ready Node backend.",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "dev:frontend": "vite --config vite.config.mjs",
    "build:frontend": "vite build --config vite.config.mjs && node scripts/publish-frontend.cjs",
    "check:frontend": "tsc --noEmit -p storefront/tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "nodemon": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}
